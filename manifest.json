{
  "manifest_version": 3,
  "name": "Claude Inline Reply",
  "version": "0.1.0",
  "description": "Highlight any block in a Claude response and reply directly to it.",

  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content/content.js"],
      "css": ["styles/content.css"],
      "run_at": "document_idle"
    }
  ],

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}